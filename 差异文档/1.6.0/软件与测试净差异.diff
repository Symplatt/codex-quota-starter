+        self.assertNotIn('ChatGPT将于', evidence(normalize(raw(20000)), normalize(raw(50000)), 20002, True))
+        self.assertNotIn('ChatGPT将于', evidence(normalize(raw(20000)), normalize(raw(38002)), 20002, False))
