+ await p.respond(s);
+ const rows=p.e('activity').children.map(row=>row.children.map(cell=>cell.textContent));
+ assert.equal(rows.length,6);assert.equal(rows[0][1],'修改定时请求');
+ assert.match(rows[0][2],/原发送时间：.*\n发送时间：.*\n预计刷新：/);
