+                                record = {'id': event_id, 'time': date.isoformat(), 'kind': kind, 'detail': detail}
+                                grouped.setdefault(date.strftime('%Y-%m'), []).append(json.dumps(record, ensure_ascii=False) + '\n')
+                            for month, lines in grouped.items():
